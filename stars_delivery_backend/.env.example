# Development is the committed example default.
# Production deployments must set NODE_ENV=production.
# Production currently assumes exactly one trusted
# TLS-terminating reverse-proxy hop.
NODE_ENV=development

PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# Generate a cryptographically random value with at least 32 characters.
JWT_SECRET=
# Generate a different cryptographically random value with at least 32 characters.
SESSION_SECRET=

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for same-origin browser access plus native/mobile clients.
# Example: https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=
# Order images are stored locally and served only as safe image types.
# Set to true only if you explicitly want a third-party public image host.
ENABLE_IMGBB_UPLOAD=false
IMGBB_API_KEY=

# Production rejects mock GPS locations by default. Set to true only
# for QA using emulators in a production-like environment.
ALLOW_MOCK_LOCATION=false


# Password recovery.
#
# Generate a cryptographically random value with at least
# 32 characters. It MUST differ from JWT_SECRET and
# SESSION_SECRET.
PASSWORD_RECOVERY_SECRET=

# Generic SMTP transport for recovery messages.
#
# Common secure configurations:
# - port 465 with SMTP_SECURE=true
# - port 587 with SMTP_SECURE=false
#   (STARTTLS is required by the application)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Authentication may be omitted for a trusted SMTP relay.
# SMTP_USER and SMTP_PASS must either both be supplied
# or both be omitted.
SMTP_USER=
SMTP_PASS=

# Example:
# Stars Delivery <no-reply@example.com>
SMTP_FROM=

# Used only by: npm run admin:bootstrap
ADMIN_EMAIL=administrator@example.com
ADMIN_FULL_NAME=Administrator
# Supply this only when explicitly running the bootstrap command; minimum 12 characters.
ADMIN_PASSWORD=

# Provider verification documents
#
# Development defaults to private/provider-documents.
# Production MUST use an absolute path backed by private
# persistent storage. Public /uploads and src/public roots
# are rejected.
PROVIDER_DOCUMENTS_DIR=

# Firebase Cloud Messaging (FCM)
#
# Provide either the full service-account JSON as a single line/string
# or an absolute path to the downloaded service-account JSON file.
# When neither is set, the API runs normally and push delivery is disabled.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
