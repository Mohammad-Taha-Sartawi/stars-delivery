<!-- مودال تعديل بيانات السائق -->
<div id="driverEditModal" class="modal-overlay">
  <div class="modal-box driver-edit-modal">
    <h2><i class="fas fa-user-edit"></i> تعديل بيانات السائق</h2>
    <div class="sub" id="driverEditSub">---</div>
    <form id="driverEditForm">
      <input type="hidden" id="driverEditId">
      <div class="form-grid">
        <div class="form-group"><label>الاسم الكامل</label><input id="driverEditName" type="text" maxlength="120" required></div>
        <div class="form-group"><label>البريد الإلكتروني</label><input id="driverEditEmail" type="email" maxlength="160" required></div>
        <div class="form-group"><label>رقم الجوال</label><input id="driverEditPhone" type="text" maxlength="30" required></div>
        <div class="form-group"><label>المعرف العام</label><input id="driverEditPublicId" type="text" maxlength="50"></div>
        <div class="form-group"><label>عمولة المنصة المستحقة (شيكل)</label><input id="driverEditCommissionDue" type="number" min="0" step="0.01" required><small>تعديل المبلغ يسجّل تسوية على حساب السائق.</small></div>
        <div class="form-group"><label>المحافظة</label><select id="driverEditGovernorate" required></select></div>
        <div class="form-group"><label>القرية / المدينة</label><select id="driverEditArea" required></select></div>
        <div class="form-group"><label>حالة الحساب</label>
          <select id="driverEditStatus">
            <option value="active">نشط</option>
            <option value="inactive">موقوف</option>
            <option value="blocked">محظور</option>
          </select>
        </div>
        <div class="form-group"><label>نوع الرخصة</label><input id="driverEditLicenseType" type="text" maxlength="120"></div>
        <div class="form-group full-width">
          <label>أنواع الخدمات</label>
          <div class="service-checkboxes">
            <label class="checkbox-line"><input id="driverEditServiceProduct" type="checkbox"> توصيل منتجات</label>
            <label class="checkbox-line"><input id="driverEditServicePeople" type="checkbox"> توصيل ركاب</label>
            <label class="checkbox-line"><input id="driverEditServiceGoods" type="checkbox"> نقل بضائع</label>
          </div>
          <small>اترك الجميع فارغاً لاستقبال جميع الخدمات.</small>
        </div>
        <div class="form-group full-width">
          <label class="checkbox-line"><input id="driverEditLicenseNotAvailable" type="checkbox"> لا يملك رخصة قيادة</label>
          <label class="checkbox-line"><input id="driverEditAvailable" type="checkbox"> متاح لاستقبال الطلبات الآن</label>
          <label class="checkbox-line"><input id="driverEditGovernorateLevel" type="checkbox"> استقبال طلبات على مستوى المحافظة</label>
        </div>
      </div>
      <div id="driverEditMsg" class="msg"></div>
      <button type="submit" class="btn-submit-driver"><i class="fas fa-save"></i> حفظ التعديلات</button>
      <button type="button" class="modal-close-btn" data-admin-action="closeDriverEdit" data-admin-arg-count="0"><i class="fas fa-times"></i> إلغاء</button>
    </form>
  </div>
</div>

<!-- مودال إعادة تعيين كلمة المرور -->
<div id="resetPasswordModal" class="modal-overlay password-modal">
  <div class="modal-box">
    <h2><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h2>
    <div class="sub">قم بتغيير كلمة المرور الخاصة بحساب المدير.</div>
    <input type="password" id="currentPassword" placeholder="كلمة المرور الحالية">
    <input type="password" id="newPassword" placeholder="كلمة المرور الجديدة">
    <input type="password" id="confirmPassword" placeholder="تأكيد كلمة المرور الجديدة">
    <button class="btn-submit" data-admin-action="handleResetPassword" data-admin-arg-count="0"><i class="fas fa-save"></i> حفظ التغييرات</button>
    <div id="resetMsg" class="msg"></div>
    <button class="modal-close-btn" data-admin-action="closeResetPassword" data-admin-arg-count="0" data-presentation="p014"><i class="fas fa-times"></i> إلغاء</button>
  </div>
</div>

<!-- مودال الشات -->
